{
  "manifest_version": 3,
  "name": "WebPilot AI — Understand the web. Take smarter action.",
  "short_name": "WebPilot AI",
  "version": "1.0.0",
  "description": "Source-grounded AI summaries, contextual Q&A, selected-text explanations, and study quizzes for Chrome & Edge.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open WebPilot AI Side Panel"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}