generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  displayName       String?         @map("display_name")
  preferredLanguage String          @default("en") @map("preferred_language")
  planIdentifier    String          @default("free_researcher") @map("plan_identifier")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  workspaces        Workspace[]
  savedItems        SavedItem[]
  conversations     Conversation[]
  usageEvents       UsageEvent[]

  @@map("users")
}

model Workspace {
  id          String         @id @default(cuid())
  ownerUserId String         @map("owner_user_id")
  name        String
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  owner       User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  savedItems  SavedItem[]
  conversations Conversation[]

  @@index([ownerUserId])
  @@map("workspaces")
}

model SavedItem {
  id               String     @id @default(cuid())
  ownerUserId      String     @map("owner_user_id")
  workspaceId      String?    @map("workspace_id")
  pageUrl          String     @map("page_url")
  pageTitle        String     @map("page_title")
  hostname         String
  summary          String
  personalNotes    String     @default("") @map("personal_notes")
  contentHash      String?    @map("content_hash")
  sourceReferences Json       @default("[]") @map("source_references")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  owner            User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([ownerUserId, hostname])
  @@map("saved_items")
}

model Conversation {
  id          String     @id @default(cuid())
  ownerUserId String     @map("owner_user_id")
  workspaceId String?    @map("workspace_id")
  title       String
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner       User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([ownerUserId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String       @map("conversation_id")
  role             String
  content          String
  sourceReferences Json         @default("[]") @map("source_references")
  createdAt        DateTime     @default(now()) @map("created_at")

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model UsageEvent {
  id               String   @id @default(cuid())
  ownerUserId      String   @map("owner_user_id")
  operation        String
  modelIdentifier  String   @map("model_identifier")
  inputTokenCount  Int      @default(0) @map("input_token_count")
  outputTokenCount Int      @default(0) @map("output_token_count")
  estimatedCost    Decimal  @default(0) @map("estimated_cost") @db.Decimal(10, 6)
  requestStatus    String   @map("request_status")
  createdAt        DateTime @default(now()) @map("created_at")

  owner            User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("usage_events")
}
